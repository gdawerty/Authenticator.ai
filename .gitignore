# --- BERT and ViT Folders (Available on Google Drive) ---
BERT/
ViT/

# --- Frontend (Vite + React + TypeScript) ---
frontend/node_modules/
frontend/dist/
frontend/.vite/

# Optional: local Vite config overrides
frontend/*.local

# --- Backend (Flask + Python) ---
backend/__pycache__/
backend/*.pyc
backend/*.pyo
backend/*.pyd
backend/instance/
backend/.pytest_cache/
backend/.mypy_cache/
backend/.coverage
backend/venv/

# --- Virtual Environment ---
.venv/
venv/
env/
ENV/

# --- Large Data Files ---
# Model files
*.pt
*.pth
*.bin
*.safetensors
artifacts/
models/*.pt
models/*.pth
models/*.bin
models/*.safetensors

# All data files and directories
*.csv
*.parquet
*.jsonl
data/

# Keep essential config files but exclude data JSON files
*.json
!package.json
!package-lock.json
!tsconfig*.json
!vite.config.*

# --- Database files (if using SQLite locally) ---
*.sqlite3
*.db

# --- Environment variables ---
*.env
*.env.*
!env.example  # allow committed example env files

# --- OS-specific ---
.DS_Store
Thumbs.db

# --- IDE / Editor ---
.vscode/
.idea/
*.swp

# --- Temporary files ---
*.tmp
*.temp
tmp_uploads/
uploads/
