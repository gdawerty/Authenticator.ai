{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "backend_new": {
      "root": "backend_new",
      "framework": "fastapi",
      "entrypoint": "app.main:app"
    },
    "frontend_new": {
      "root": "frontend_new",
      "framework": "vite",
      "rewrites": [
        {
          "source": "/(.*)",
          "destination": "/index.html"
        }
      ]
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "backend_new"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend_new"
      }
    }
  ]
}
